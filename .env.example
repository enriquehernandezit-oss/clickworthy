# Clickworthy environment. Copy to .env.local and fill in.
# .env.local is gitignored — never commit real keys.

# --- Database (Railway Postgres) ---
# Local/migrations: use the PUBLIC url (…proxy.rlwy.net). On the Railway
# services themselves, use the internal reference ${{Postgres.DATABASE_URL}}.
DATABASE_URL=

# --- AI + enhancement ---
ANTHROPIC_API_KEY=          # Claude — photo scoring, signature-dish, copy, moderation
CLAID_API_KEY=              # Claid.ai — optional one-click photo first pass

# --- Lead sourcing ---
GOOGLE_MAPS_API_KEY=        # Google Places API (New), billing enabled
NEVERBOUNCE_API_KEY=        # verify discovered emails before sending

# --- Cold email (Gmail service account, domain-wide delegation) ---
GMAIL_SENDER=mail@clickworthytool.com
GOOGLE_SERVICE_ACCOUNT_JSON=   # full service-account JSON key, single line
OUTREACH_ENABLED=false         # master send switch — real cold email only sends when "true"
OUTREACH_POSTAL_ADDRESS=       # CAN-SPAM footer (legally required in every send)

# --- Transactional email + operator alerts (Resend) ---
RESEND_API_KEY=
ALERT_EMAIL_TO=                # where reply/failure alerts + weekly report go
ALERT_EMAIL_FROM=alerts@clickworthytool.com

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=         # from the registered /api/webhooks/stripe endpoint

# --- Photo storage (Cloudflare R2; optional — falls back to Postgres blob) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_PUBLIC_URL_BASE=

# --- Admin dashboard (Basic Auth on /admin) ---
ADMIN_USER=
ADMIN_PASSWORD=

# --- Booking link for the retainer tier (Cal.com / Calendly) ---
# Public var: shown on the landing + funnel and used in the Touch 2 email.
# If unset, the "Book a 15-min call" CTA is hidden gracefully.
NEXT_PUBLIC_BOOKING_URL=

# --- App origin (magic-link URLs + storage-fallback absolute URLs) ---
APP_ORIGIN=https://clickworthytool.com
